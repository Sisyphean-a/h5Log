{
  "name": "h5-log",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "npm run build -w @h5-log/sdk && node scripts/dev.mjs",
    "build": "npm run build -w @h5-log/sdk && npm run build -w @h5-log/app",
    "start": "node packages/app/dist/server/cli.mjs",
    "pack:sdk": "npm run build -w @h5-log/sdk && npm pack -w @h5-log/sdk",
    "typecheck": "npm run build -w @h5-log/sdk && tsc --noEmit -p packages/sdk && tsc --noEmit -p packages/app && tsc --noEmit -p packages/app/tsconfig.server.json",
    "test": "npm run build -w @h5-log/sdk && vitest run",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.4.6",
    "axios": "1.21.1",
    "fake-indexeddb": "6.2.8",
    "jsdom": "31.0.0",
    "naive-ui": "2.45.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue": "3.5.45"
  }
}
