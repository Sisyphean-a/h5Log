{
  "name": "@h5-log/sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "测试环境 H5 远程日志 SDK",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "import": "./dist/fetch.js"
    },
    "./axios": {
      "types": "./dist/axios.d.ts",
      "import": "./dist/axios.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "axios": "^1.7.0"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    }
  }
}
